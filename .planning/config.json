{
  "model_profile": "adaptive",
  "context_window": 1000000,
  "commit_docs": true,
  "parallelization": false,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "phase",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": "gsd/quick-{slug}",
    "create_tag": false
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": false,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "use_worktrees": false,
    "_auto_chain_active": false,
    "ai_integration_phase": true,
    "plan_review_convergence": true,
    "auto_prune_state": true,
    "max_discuss_passes": 5,
    "cross_ai_execution": false,
    "cross_ai_command": "",
    "cross_ai_timeout": 1200,
    "tdd_mode": false,
    "code_review_depth": "deep"
  },
  "hooks": {
    "context_warnings": true
  },
  "resolve_model_ids": false,
  "mode": "interactive",
  "granularity": "standard",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  },
  "review": {
    "parallel_lanes": true,
    "default_reviewers": [
      "codex",
      "opencode",
      "antigravity"
    ],
    "models": {
      "codex": "gpt-5.6-sol",
      "opencode": "openrouter/z-ai/glm-5.3",
      "agy": "gemini-3.1-pro-high"
    }
  },
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "lsp"
  },
  "agent_skills": {
    "gsd-executor": "spike-findings-lifx-async",
    "gsd-planner": "spike-findings-lifx-async"
  },
  "effort": {
    "agent_overrides": {
      "gsd-plan-checker": "high"
    }
  }
}
